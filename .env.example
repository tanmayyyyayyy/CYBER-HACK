# Local storage and service behavior
DRISHTI_DATA_DIR=
DRISHTI_DISABLE_AUTO_STREAMS=1
DRISHTI_COOKIE_SECURE=0
DRISHTI_MAX_VAULT_BYTES=21474836480

# Network cameras: comma-separated private CIDRs; required for IP cameras
DRISHTI_CAMERA_NETWORKS=

# Security portal bridge. Use a long random secret and configure the same value
# for the portal and main service.
DRISHTI_BRIDGE_KEY=
DRISHTI_SECURITY_PORTAL_URL=http://127.0.0.1:8100/sec-api/bridge/event

# Optional chain anchoring (disabled unless configured)
DRISHTI_CHAIN_RPC_URL=
DRISHTI_CHAIN_ID=
DRISHTI_CHAIN_SENDER=
DRISHTI_CHAIN_DEMO=0

# Optional computer vision features
DRISHTI_ADVANCED_VISION=1
DRISHTI_ROBBERY_VISION=0
DRISHTI_CAMERA_ZONES={}

# Optional HTTPS integration endpoints. Both URL and token must be set;
# otherwise the capability remains in mock mode.
DRISHTI_AUDIT_CHECKPOINT_URL=
DRISHTI_AUDIT_CHECKPOINT_TOKEN=
DRISHTI_AUDIT_CHECKPOINT_SIGNING_KEY=
DRISHTI_DISPATCH_WEBHOOK_URL=
DRISHTI_DISPATCH_TOKEN=

# Optional manual retention. Must be a positive whole number of days.
# Missing/invalid values disable retention and retain all records.
DRISHTI_RETENTION_DAYS=

# Informational operator assertion only; the app cannot verify host encryption.
DRISHTI_HOST_ENCRYPTION_CONFIRMED=0
